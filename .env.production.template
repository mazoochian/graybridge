# Copy this to .env.production (or set these directly as real environment
# variables via your process manager / Docker / systemd — do NOT commit
# an actual filled-in .env.production, it's already gitignored like the
# other .env* files here) and fill in real values before deploying.
#
# scripts/check-env.mjs (run automatically by `npm start`/`node
# scripts/check-env.mjs && next start`, and inside Docker's CMD) will
# refuse to boot the server if DATABASE_URL or AUTH_SECRET are missing.

# ---- Required -----------------------------------------------------------

# Real production Postgres connection string. The local dev Postgres
# container documented in NOTES.md is dev-only — provision a real
# instance on/near the VPS and point this at it, then run
# `npx prisma migrate deploy` against it once before first boot (and
# again after any future schema change — this is a manual/deploy-script
# step, not run automatically on container start, see Dockerfile).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Secret used to sign admin + customer session JWTs (lib/auth.ts,
# lib/customer-auth.ts). Generate a real random one, e.g.:
#   openssl rand -hex 32
# Rotating this invalidates every existing session (forces re-login).
AUTH_SECRET=""

# ---- Optional -------------------------------------------------------

# One-time admin bootstrap credentials, read by prisma/seed.ts when
# seeding a fresh database. If unset, seed.ts defaults to username
# "admin" and a random generated password (printed to seed output/
# .admin-credentials.local.txt in local dev — on a server, capture that
# output somewhere safe instead, or set these explicitly here so you
# know the credentials up front).
# ADMIN_USERNAME="admin"
# ADMIN_PASSWORD=""

# Email: staying on the local-mail/ stub until a provider is chosen (see
# NOTES.md). Set RESEND_API_KEY once you have one and lib/mail.ts starts
# sending real emails automatically — no code change needed.
# RESEND_API_KEY=""
# MAIL_FROM="orders@yourdomain.example"

# Standard Next.js production flag — the app already checks this via
# NODE_ENV internally in a few places (secure cookies, etc). Docker's
# runner stage (see Dockerfile) already sets this; only needed here if
# running `next start` outside Docker.
# NODE_ENV="production"
