// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id        Int      @id @default(autoincrement())
  name      String
  cat       String
  price     Int
  wasPrice  Int?
  imgId     String
  images    String   @default("[]") // JSON-encoded string[]; images[0] is the cover, kept in sync with imgId
  colors    String // JSON-encoded string[]
  tags      String // JSON-encoded string[]
  // rating/reviews are maintained aggregates over `reviewList`, the same
  // way `stock` below is a maintained aggregate over `variants` — kept
  // denormalized so product grids don't need to join/count reviews per
  // card. Both are recomputed inside the same transaction as any review
  // write (see app/api/products/[id]/reviews/route.ts). rating is a
  // String ("4.6") rather than a Float because that's the shape the
  // storefront and CSV export already expect.
  rating    String
  reviews   Int      @default(0)
  stock     Int      @default(0) // maintained aggregate = sum(variants.stock)
  sku       String   @unique
  desc      String   @default("")
  ord       Int      @default(0)
  // Soft delete: archived products are hidden from the public storefront
  // and admin's default list, but the row (and any historical OrderItem
  // rows referencing this id) is kept — orders reference products by id,
  // so a hard delete would corrupt order history.
  archived  Boolean  @default(false)
  variants  ProductVariant[]
  // Named reviewList, not reviews, because `reviews` above is already
  // taken by the denormalized count.
  reviewList Review[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id         Int      @id @default(autoincrement())
  product    Product  @relation(fields: [productId], references: [id])
  productId  Int
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId Int
  rating     Int // 1-5, validated at the API boundary
  title      String   @default("")
  body       String   @default("")
  // Whether this customer had actually ordered this product at the time
  // they reviewed it. Stored rather than derived so the badge doesn't
  // change retroactively if order history is ever edited.
  verified   Boolean  @default(false)
  // Maintained aggregate over `votes`, same pattern as Product.reviews —
  // kept denormalized so listing reviews doesn't need a count per row,
  // and recomputed in the same transaction as any vote change.
  helpful    Int      @default(0)
  votes      ReviewVote[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // One review per customer per product; re-submitting edits in place.
  @@unique([productId, customerId])
  @@index([productId])
}

model ReviewVote {
  id         Int      @id @default(autoincrement())
  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId   Int
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId Int
  createdAt  DateTime @default(now())

  // One vote per customer per review; voting again removes it (toggle).
  @@unique([reviewId, customerId])
  @@index([reviewId])
}

model ProductVariant {
  id        Int     @id @default(autoincrement())
  product   Product @relation(fields: [productId], references: [id])
  productId Int
  size      String
  color     String
  stock     Int     @default(0)

  @@unique([productId, size, color])
}

model AdminUser {
  id           Int    @id @default(autoincrement())
  username     String @unique
  passwordHash String
  role         String @default("owner")
}

model DiscountCode {
  id           Int       @id @default(autoincrement())
  code         String    @unique
  type         String // "percent" | "fixed"
  value        Int
  active       Boolean   @default(true)
  minSubtotal  Int       @default(0)
  usageLimit   Int?
  usedCount    Int       @default(0)
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
}

model Order {
  id              Int         @id @default(autoincrement())
  orderNumber     String      @unique
  email           String
  name            String
  addressLine1    String
  addressLine2    String      @default("")
  city            String
  region          String
  postalCode      String
  country         String
  phone           String      @default("")
  subtotal        Int
  shipping        Int
  tax             Float
  total           Float
  status          String      @default("Processing")
  paymentStatus   String      @default("paid")
  paymentProvider String      @default("test-mode")
  paymentRef      String      @default("")
  discountCode    String      @default("")
  discountAmount  Float       @default(0)
  carrier         String      @default("")
  trackingNumber  String      @default("")
  items           OrderItem[]
  customer        Customer?   @relation(fields: [customerId], references: [id])
  customerId      Int?
  createdAt       DateTime    @default(now())
}

model Customer {
  id           Int                @id @default(autoincrement())
  email        String             @unique
  name         String
  passwordHash String
  addresses    Address[]
  wishlist     WishlistItem[]
  orders       Order[]
  resetTokens  PasswordResetToken[]
  reviews      Review[]
  reviewVotes  ReviewVote[]
  createdAt    DateTime           @default(now())
}

model Address {
  id           Int      @id @default(autoincrement())
  customer     Customer @relation(fields: [customerId], references: [id])
  customerId   Int
  label        String   @default("")
  addressLine1 String
  addressLine2 String   @default("")
  city         String
  region       String
  postalCode   String
  country      String
  phone        String   @default("")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model WishlistItem {
  id         Int      @id @default(autoincrement())
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId Int
  productId  Int
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
}

model PasswordResetToken {
  id         Int      @id @default(autoincrement())
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId Int
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())
}

model OrderItem {
  id        Int    @id @default(autoincrement())
  order     Order  @relation(fields: [orderId], references: [id])
  orderId   Int
  productId Int
  name      String
  sku       String
  size      String
  color     String
  qty       Int
  unitPrice Int
}
